---
import BaseLayout from '../layouts/BaseLayout.astro';
import rawTopics from '../data/topics.json';
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Auto-sync topic status against actual filesystem (content-queue & src/content/blog)
const topicBank = rawTopics.map((t) => {
  const inBlog = fs.existsSync(path.resolve(`src/content/blog/${t.id}/index.md`));
  const inQueue = fs.existsSync(path.resolve(`content-queue/${t.id}/index.md`));
  const resolvedStatus = inBlog ? 'published' : inQueue ? 'drafting' : t.status || 'pending';
  return {
    ...t,
    resolvedStatus,
    publishedSlug: inBlog ? t.id : t.publishedSlug || '',
  };
});

const counts = {
  all: topicBank.length,
  pending: topicBank.filter((t) => t.resolvedStatus === 'pending').length,
  drafting: topicBank.filter((t) => t.resolvedStatus === 'drafting').length,
  published: topicBank.filter((t) => t.resolvedStatus === 'published').length,
};

// Build selectable drafts/articles map for the Studio editor
const candidateDirs = [
  '2026-11-30-shenzhen-zhongshan-bridge',
  '2026-11-24-santiago-bernabeu',
  '2026-11-25-beijing-daxing-airport',
  '2026-11-23-sofi-stadium',
];

type ProjectDoc = {
  slug: string;
  label: string;
  stage: string;
  title: string;
  date: string;
  category: string;
  description: string;
  source: string;
  infographic: string;
  body: string;
  images: { file: string; url: string; label: string }[];
};

function parseDoc(slug: string): ProjectDoc | null {
  const qPath = path.resolve(`content-queue/${slug}/index.md`);
  const bPath = path.resolve(`src/content/blog/${slug}/index.md`);
  const activePath = fs.existsSync(qPath) ? qPath : fs.existsSync(bPath) ? bPath : '';
  if (!activePath) return null;

  const stage = fs.existsSync(qPath) ? '待发布队列' : '已发布';
  const raw = fs.readFileSync(activePath, 'utf-8');
  const fmMatch = raw.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
  const fmText = fmMatch ? fmMatch[1] : '';
  const body = fmMatch ? fmMatch[2].trim() : raw;

  const getFm = (k: string, fb = '') => {
    const m = fmText.match(new RegExp(`^${k}:\\s*"(.*)"`, 'm'));
    return m ? m[1] : fb;
  };

  // Scan local images under public/projects/<slug>/candidates or public/projects/<slug>/
  const candDir = path.resolve(`public/projects/${slug}/candidates`);
  const rootAssetDir = path.resolve(`public/projects/${slug}`);
  const images: { file: string; url: string; label: string }[] = [];

  if (fs.existsSync(candDir)) {
    for (const f of fs.readdirSync(candDir).sort()) {
      if (/\.(jpg|jpeg|png|webp)$/i.test(f)) {
        images.push({
          file: f,
          url: `${base}/projects/${slug}/candidates/${f}`,
          label: f.replace(/\.\w+$/, ''),
        });
      }
    }
  } else if (fs.existsSync(rootAssetDir)) {
    for (const f of fs.readdirSync(rootAssetDir).sort()) {
      if (/\.(jpg|jpeg|png|webp)$/i.test(f)) {
        images.push({
          file: f,
          url: `${base}/projects/${slug}/${f}`,
          label: f.replace(/\.\w+$/, ''),
        });
      }
    }
  }

  const title = getFm('title', slug);
  return {
    slug,
    label: `[${stage}] ${title}`,
    stage,
    title,
    date: getFm('date', '2026-11-24'),
    category: getFm('category', '地标建筑'),
    description: getFm('description', ''),
    source: getFm('source', ''),
    infographic: getFm('infographic', images[0]?.url.replace(base, '') || ''),
    body,
    images,
  };
}

const projectDocs = candidateDirs.map(parseDoc).filter((d): d is ProjectDoc => Boolean(d));
const defaultDoc = projectDocs[0];
---

<BaseLayout title="创作后台 · 选题累积库与稿件预览 | 钢结构研究院" description="每日3选题规划与历史选题累积回溯，支持Swarm指令生成、配图筛选与Markdown整体效果预览。">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <!-- Top Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-5 border-b border-slate-200 dark:border-slate-800 mb-6">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-mono text-sky-600 dark:text-sky-400 mb-1">
          <span>EDITORIAL STUDIO</span>
          <span>·</span>
          <span>选题累积池 + 万字稿件工作台</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">选题规划与稿件编辑后台</h1>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <div class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs">
          字数：<strong id="stat-chars" class="text-sky-600 dark:text-sky-400 text-sm">0</strong> 字
        </div>
        <div class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs">
          已配图：<strong id="stat-imgs" class="text-emerald-600 dark:text-emerald-400 text-sm">0</strong> 张
        </div>
        <div id="stat-density" class="px-3 py-1.5 rounded-xl bg-sky-50 dark:bg-sky-950/50 border border-sky-200 dark:border-sky-800 text-xs font-medium text-sky-800 dark:text-sky-300">
          密度检测中...
        </div>
      </div>
    </div>

    <!-- Step 0: Persistent Cumulative Topic Bank -->
    <section class="mb-8 p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 mb-4">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-wider text-sky-600 dark:text-sky-400">STEP 0 · PERSISTENT TOPIC BANK</span>
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">选题累积库（每日新增 3 选题 · 历史选题可回溯）</h2>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button type="button" data-status-filter="all" class="topic-filter-btn px-3 py-1 rounded-lg text-xs font-medium bg-sky-600 text-white cursor-pointer">
            全部 ({counts.all})
          </button>
          <button type="button" data-status-filter="pending" class="topic-filter-btn px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 cursor-pointer">
            待创作 ({counts.pending})
          </button>
          <button type="button" data-status-filter="drafting" class="topic-filter-btn px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 cursor-pointer">
            审稿中 ({counts.drafting})
          </button>
          <button type="button" data-status-filter="published" class="topic-filter-btn px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 cursor-pointer">
            已发布 ({counts.published})
          </button>
          <button
            id="btn-new-daily-topics"
            type="button"
            class="px-3 py-1 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white cursor-pointer transition-colors"
          >
            + 复制「生成今日3新选题」指令
          </button>
        </div>
      </div>

      <p id="topic-status" class="mb-4 text-xs text-slate-500 dark:text-slate-400">
        提示：选定任意「待创作」选题可一键复制 Swarm 深度调研指令；已发布项目可直接回溯文章或切入下方编辑器二次精修。
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4" id="topic-grid">
        {topicBank.map((t) => {
          const statusLabel =
            t.resolvedStatus === 'published'
              ? '已发布'
              : t.resolvedStatus === 'drafting'
              ? '审稿中'
              : '待创作';
          const statusClass =
            t.resolvedStatus === 'published'
              ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300'
              : t.resolvedStatus === 'drafting'
              ? 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300'
              : 'bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300';
          return (
            <div
              data-topic-status={t.resolvedStatus}
              class="topic-card group rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-950/60 overflow-hidden flex flex-col justify-between hover:border-sky-400 transition-all"
            >
              <div>
                <div class="aspect-video bg-white dark:bg-slate-900 overflow-hidden border-b border-slate-200 dark:border-slate-800">
                  <img src={`${base}${t.image}`} alt={t.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                </div>
                <div class="p-4">
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <span class={`px-2 py-0.5 rounded-full text-[11px] font-semibold ${statusClass}`}>
                      {statusLabel}
                    </span>
                    <span class="text-[11px] font-mono text-slate-400">入库 {t.addedDate}</span>
                  </div>
                  <div class="text-[11px] text-sky-700 dark:text-sky-400 font-medium mb-1">{t.tag}</div>
                  <h3 class="font-bold text-sm text-slate-900 dark:text-white">{t.title}</h3>
                  <p class="mt-1.5 text-xs text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3">{t.summary}</p>
                  <div class="mt-2.5 flex flex-wrap gap-1">
                    {t.highlights.map((h) => (
                      <span class="px-1.5 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[10px] text-slate-600 dark:text-slate-300">
                        {h}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
              <div class="px-4 pb-4 flex gap-2">
                {t.resolvedStatus === 'published' && t.publishedSlug ? (
                  <a
                    href={`${base}/blog/${t.publishedSlug}/`}
                    class="flex-1 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium text-center transition-colors"
                  >
                    查看已发布文章
                  </a>
                ) : t.resolvedStatus === 'drafting' ? (
                  <button
                    type="button"
                    data-edit-slug={t.id}
                    class="btn-edit-draft flex-1 py-2 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-xs font-medium cursor-pointer transition-colors"
                  >
                    进入下方审稿编辑 ↓
                  </button>
                ) : (
                  <button
                    type="button"
                    data-topic-title={t.title}
                    data-topic-id={t.id}
                    class="btn-pick-topic flex-1 py-2 rounded-lg bg-slate-900 hover:bg-sky-600 dark:bg-sky-600 dark:hover:bg-sky-500 text-white text-xs font-medium cursor-pointer transition-colors"
                  >
                    选定选题 · 启动 Swarm 调研
                  </button>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Project Switcher for Editor -->
    <div class="mb-4 p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="text-sm font-bold text-slate-900 dark:text-white">
        切换正在编辑的稿件 / 项目文件夹：
      </div>
      <select id="project-switcher" class="px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-xs sm:text-sm font-medium">
        {projectDocs.map((doc) => (
          <option value={doc.slug}>{doc.label}</option>
        ))}
      </select>
    </div>

    <div class="grid lg:grid-cols-12 gap-6">
      <!-- Left: Candidate Image Picker (4 cols) -->
      <div class="lg:col-span-4 space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold text-slate-900 dark:text-white">1. 本项目本地配图库 (<span id="cand-count">{defaultDoc?.images.length || 0}</span> 张)</h2>
          <button
            id="btn-auto-insert"
            type="button"
            class="px-2.5 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-700 text-white text-xs font-medium cursor-pointer transition-colors"
          >
            自动插入各章节
          </button>
        </div>

        <div id="cand-list" class="space-y-2.5 max-h-[860px] overflow-y-auto pr-1"></div>
      </div>

      <!-- Right: Frontmatter + Dual Mode Editor & Live Preview (8 cols) -->
      <div class="lg:col-span-8 space-y-4">
        <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-sm font-bold text-slate-900 dark:text-white">2. 规范格式元数据（Frontmatter）</h2>
            <div class="flex gap-2">
              <button id="btn-copy-md" type="button" class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 text-xs font-medium cursor-pointer">
                复制完整 Markdown
              </button>
              <button id="btn-download-md" type="button" class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium cursor-pointer">
                导出 index.md
              </button>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-2.5 text-xs">
            <label class="block">
              <span class="text-slate-500">文章标题</span>
              <input id="fm-title" type="text" value={defaultDoc?.title || ''} class="mt-1 w-full px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950" />
            </label>
            <div class="grid grid-cols-2 gap-2">
              <label class="block">
                <span class="text-slate-500">发布日期</span>
                <input id="fm-date" type="text" value={defaultDoc?.date || ''} class="mt-1 w-full px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950" />
              </label>
              <label class="block">
                <span class="text-slate-500">专栏分类</span>
                <select id="fm-category" class="mt-1 w-full px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950">
                  <option value="地标建筑">地标建筑</option>
                  <option value="超级工程">超级工程</option>
                  <option value="参数化与AI">参数化与AI</option>
                  <option value="行业洞察">行业洞察</option>
                </select>
              </label>
            </div>
            <label class="block sm:col-span-2">
              <span class="text-slate-500">文章摘要（description）</span>
              <input id="fm-desc" type="text" value={defaultDoc?.description || ''} class="mt-1 w-full px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950" />
            </label>
            <label class="block">
              <span class="text-slate-500">资料来源（source）</span>
              <input id="fm-source" type="text" value={defaultDoc?.source || ''} class="mt-1 w-full px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950" />
            </label>
            <label class="block">
              <span class="text-slate-500">顶部主图 / 信息图（infographic）</span>
              <input id="fm-infographic" type="text" value={defaultDoc?.infographic || ''} class="mt-1 w-full px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 font-mono" />
            </label>
          </div>
        </div>

        <!-- Editor + Preview Panel -->
        <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <h2 class="text-sm font-bold text-slate-900 dark:text-white">3. 正文编辑与整体效果实时预览</h2>
            <div class="inline-flex rounded-lg border border-slate-200 dark:border-slate-700 p-0.5 bg-slate-100 dark:bg-slate-950 text-xs">
              <button type="button" data-mode="edit" class="view-mode-btn px-2.5 py-1 rounded-md font-medium cursor-pointer text-slate-600 dark:text-slate-300">
                Markdown 编辑
              </button>
              <button type="button" data-mode="split" class="view-mode-btn px-2.5 py-1 rounded-md font-medium cursor-pointer bg-white dark:bg-slate-800 text-sky-600 dark:text-sky-400 shadow-sm">
                左右分栏对照
              </button>
              <button type="button" data-mode="preview" class="view-mode-btn px-2.5 py-1 rounded-md font-medium cursor-pointer text-slate-600 dark:text-slate-300">
                整体效果预览
              </button>
            </div>
          </div>

          <div id="img-anchor-map" class="mb-3 p-2.5 rounded-xl bg-amber-50/70 dark:bg-amber-950/30 border border-amber-200/80 dark:border-amber-800/60 flex flex-wrap gap-2"></div>

          <div id="editor-container" class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <div id="pane-edit">
              <textarea
                id="md-editor"
                rows={26}
                class="w-full p-3.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 text-xs sm:text-sm font-mono leading-relaxed focus:outline-none focus:ring-2 focus:ring-sky-500"
              >{defaultDoc?.body || ''}</textarea>
            </div>

            <div id="pane-preview" class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-950/60 p-5 max-h-[650px] overflow-y-auto">
              <div id="preview-header" class="mb-5 pb-4 border-b border-slate-200 dark:border-slate-800"></div>
              <div id="preview-top-img"></div>
              <div id="preview-body" class="prose prose-slate dark:prose-invert prose-editorial max-w-none"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script id="studio-docs-data" type="application/json" set:html={JSON.stringify(projectDocs)}></script>

  <script>
    import { marked } from 'marked';

    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    const docsData = JSON.parse(document.getElementById('studio-docs-data')?.textContent || '[]');
    const editor = document.getElementById('md-editor') as HTMLTextAreaElement;
    const statChars = document.getElementById('stat-chars')!;
    const statImgs = document.getElementById('stat-imgs')!;
    const statDensity = document.getElementById('stat-density')!;
    const anchorMap = document.getElementById('img-anchor-map')!;
    const previewHeader = document.getElementById('preview-header')!;
    const previewTopImg = document.getElementById('preview-top-img')!;
    const previewBody = document.getElementById('preview-body')!;
    const candList = document.getElementById('cand-list')!;
    const candCount = document.getElementById('cand-count')!;
    const switcher = document.getElementById('project-switcher') as HTMLSelectElement;

    function renderCandidates(doc: any) {
      const imgs = doc?.images || [];
      candCount.textContent = String(imgs.length);
      if (imgs.length === 0) {
        candList.innerHTML = '<div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 text-xs text-slate-400">当前项目尚无本地候选图，请先选定选题并运行 Swarm 调研抓取。</div>';
        return;
      }
      candList.innerHTML = imgs
        .map(
          (c: any, idx: number) => `
          <div class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex gap-3 items-start">
            <a href="${c.url}" target="_blank" class="shrink-0 block w-24 h-18 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 bg-slate-100">
              <img src="${c.url}" alt="${c.label}" class="w-full h-full object-cover hover:scale-105 transition-transform" />
            </a>
            <div class="flex-1 min-w-0">
              <label class="flex items-center gap-1.5 text-xs font-bold text-slate-900 dark:text-white cursor-pointer">
                <input type="checkbox" class="cand-check rounded border-slate-300 text-sky-600" value="${c.url}" data-caption="${c.label}" ${idx < 6 ? 'checked' : ''} />
                <span class="truncate">${c.label}</span>
              </label>
              <div class="mt-2 flex flex-wrap gap-1.5">
                <button type="button" data-insert-src="${c.url}" data-insert-cap="${c.label}" class="btn-insert-one px-2 py-0.5 rounded bg-slate-100 hover:bg-sky-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 text-[11px] cursor-pointer">+ 插入正文</button>
                <button type="button" data-cover-src="${c.url.replace(base, '')}" class="btn-set-cover px-2 py-0.5 rounded bg-slate-100 hover:bg-amber-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 text-[11px] cursor-pointer">设为顶部主图</button>
                <a href="${c.url}" download="${c.file}" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-[11px]">下载</a>
              </div>
            </div>
          </div>`
        )
        .join('');

      candList.querySelectorAll('.btn-insert-one').forEach((btn) => {
        btn.addEventListener('click', () => {
          const src = btn.getAttribute('data-insert-src');
          const cap = btn.getAttribute('data-insert-cap');
          const snippet = `\n\n![${cap}](${src})\n\n`;
          const pos = editor.selectionStart || editor.value.length;
          editor.value = editor.value.slice(0, pos) + snippet + editor.value.slice(pos);
          updateAll();
        });
      });

      candList.querySelectorAll('.btn-set-cover').forEach((btn) => {
        btn.addEventListener('click', () => {
          (document.getElementById('fm-infographic') as HTMLInputElement).value = btn.getAttribute('data-cover-src') || '';
          updateAll();
        });
      });
    }

    function loadDoc(slug: string) {
      const doc = docsData.find((d: any) => d.slug === slug) || docsData[0];
      if (!doc) return;
      (document.getElementById('fm-title') as HTMLInputElement).value = doc.title;
      (document.getElementById('fm-date') as HTMLInputElement).value = doc.date;
      (document.getElementById('fm-category') as HTMLSelectElement).value = doc.category;
      (document.getElementById('fm-desc') as HTMLInputElement).value = doc.description;
      (document.getElementById('fm-source') as HTMLInputElement).value = doc.source;
      (document.getElementById('fm-infographic') as HTMLInputElement).value = doc.infographic;
      editor.value = doc.body;
      renderCandidates(doc);
      updateAll();
    }

    function renderPreview() {
      const title = (document.getElementById('fm-title') as HTMLInputElement).value;
      const date = (document.getElementById('fm-date') as HTMLInputElement).value;
      const cat = (document.getElementById('fm-category') as HTMLSelectElement).value;
      const desc = (document.getElementById('fm-desc') as HTMLInputElement).value;
      const src = (document.getElementById('fm-source') as HTMLInputElement).value;
      const info = (document.getElementById('fm-infographic') as HTMLInputElement).value.trim();

      previewHeader.innerHTML = `
        <div class="flex flex-wrap gap-2 text-xs text-slate-500 mb-2">
          <span class="px-2 py-0.5 rounded-full bg-sky-100 text-sky-700 font-medium">${cat}</span>
          <span>${date}</span>
          ${src ? `<span>· 来源：${src}</span>` : ''}
        </div>
        <h1 class="text-xl font-extrabold text-slate-900 dark:text-white leading-snug">${title}</h1>
        ${desc ? `<p class="mt-2 text-xs text-slate-600 dark:text-slate-400 bg-white dark:bg-slate-900 p-2.5 rounded-lg border-l-4 border-sky-500">${desc}</p>` : ''}
      `;

      if (info) {
        const fullInfoUrl = info.startsWith('http') || info.startsWith(base) ? info : `${base}${info}`;
        previewTopImg.innerHTML = `
          <figure class="article-figure mb-6">
            <img src="${fullInfoUrl}" alt="${title}" />
            <figcaption class="article-figcaption">
              <span class="font-bold text-sky-700 dark:text-sky-400">【项目全景工程信息图】</span> ${title}
            </figcaption>
          </figure>
        `;
      } else {
        previewTopImg.innerHTML = '';
      }

      previewBody.innerHTML = marked.parse(editor.value || '') as string;

      let idx = 1;
      previewBody.querySelectorAll('p > img').forEach((img) => {
        const p = img.parentElement;
        if (!p || p.childNodes.length > 1) return;
        const fig = document.createElement('figure');
        fig.className = 'article-figure not-prose';
        fig.appendChild(img.cloneNode(true));
        const alt = (img.getAttribute('alt') || '').trim();
        if (alt) {
          const cap = document.createElement('figcaption');
          cap.className = 'article-figcaption';
          cap.innerHTML = `<span class="font-bold text-sky-700 dark:text-sky-400 mr-1.5">配图 ${idx}</span><span>${alt}</span>`;
          fig.appendChild(cap);
        }
        idx++;
        p.replaceWith(fig);
      });
    }

    function renderAnchorMap(text: string) {
      const lines = text.split('\n');
      let currentSection = '引言';
      const anchors: { caption: string; section: string; lineNum: number; charPos: number }[] = [];
      let offset = 0;

      for (let i = 0; i < lines.length; i++) {
        const line = lines[i];
        if (line.startsWith('## ')) {
          currentSection = line.replace(/^##\s+/, '').slice(0, 14);
        }
        const m = line.match(/^!\[([^\]]*)\]\(([^)]+)\)/);
        if (m) {
          anchors.push({
            caption: m[1] || '未命名图片',
            section: currentSection,
            lineNum: i + 1,
            charPos: offset,
          });
        }
        offset += line.length + 1;
      }

      if (anchors.length === 0) {
        anchorMap.innerHTML = '<span class="text-xs text-amber-700 dark:text-amber-300">暂无正文插图，可从左侧勾选后点击「自动插入各章节」</span>';
        return;
      }

      anchorMap.innerHTML = anchors
        .map(
          (a, idx) => `
          <button
            type="button"
            data-jump="${a.charPos}"
            class="jump-anchor-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-amber-500/15 hover:bg-amber-500/25 border border-amber-400/60 text-amber-900 dark:text-amber-200 text-xs font-medium cursor-pointer transition-colors"
            title="点击跳转到第 ${a.lineNum} 行"
          >
            <span class="w-4 h-4 rounded-full bg-amber-500 text-white text-[10px] font-bold flex items-center justify-center">${idx + 1}</span>
            <span>[${a.section}]</span>
            <span class="max-w-[130px] truncate">${a.caption}</span>
          </button>`
        )
        .join('');

      document.querySelectorAll('.jump-anchor-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const pos = Number(btn.getAttribute('data-jump'));
          editor.focus();
          editor.setSelectionRange(pos, pos + 4);
          const ratio = pos / Math.max(1, editor.value.length);
          editor.scrollTop = Math.max(0, ratio * editor.scrollHeight - 80);
        });
      });
    }

    function updateAll() {
      const text = editor.value || '';
      const chars = text.replace(/\s+/g, '').length;
      const bodyImgs = (text.match(/!\[[^\]]*\]\([^)]+\)/g) || []).length;
      const hasTopInfo = Boolean((document.getElementById('fm-infographic') as HTMLInputElement).value.trim());
      const totalImgs = bodyImgs + (hasTopInfo ? 1 : 0);

      statChars.textContent = chars.toLocaleString();
      statImgs.textContent = String(totalImgs);
      renderAnchorMap(text);
      renderPreview();

      const required = Math.max(5, Math.ceil(chars / 2000));
      if (totalImgs >= required) {
        statDensity.textContent = `配图达标（需 ≥${required} 张，当前 ${totalImgs} 张）`;
        statDensity.className = 'px-3 py-1.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-xs font-medium text-emerald-700 dark:text-emerald-300';
      } else {
        statDensity.textContent = `建议再配 ${required - totalImgs} 张图（每2000字1张，需 ≥${required} 张）`;
        statDensity.className = 'px-3 py-1.5 rounded-xl bg-amber-50 dark:bg-amber-950/50 border border-amber-200 dark:border-amber-800 text-xs font-medium text-amber-800 dark:text-amber-300';
      }
    }

    // Topic Bank Filtering
    const topicCards = document.querySelectorAll('.topic-card');
    document.querySelectorAll('.topic-filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const f = btn.getAttribute('data-status-filter');
        document.querySelectorAll('.topic-filter-btn').forEach((b) => {
          b.className = 'topic-filter-btn px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 cursor-pointer';
        });
        btn.className = 'topic-filter-btn px-3 py-1 rounded-lg text-xs font-medium bg-sky-600 text-white cursor-pointer';
        topicCards.forEach((c) => {
          const st = c.getAttribute('data-topic-status');
          c.classList.toggle('hidden', f !== 'all' && st !== f);
        });
      });
    });

    // Generate new 3 daily topics prompt
    document.getElementById('btn-new-daily-topics')?.addEventListener('click', async () => {
      const cmd = '请使用 steel-blog-workflow 工作流，联网检索今天全球钢结构与超级工程热点，为我增量追加 3 个全新选题到 src/data/topics.json，并为每个选题生成白底中文信息图。';
      try { await navigator.clipboard.writeText(cmd); } catch {}
      const statusEl = document.getElementById('topic-status');
      if (statusEl) {
        statusEl.textContent = '已复制「生成今日 3 新选题」指令！直接粘贴发给 Antigravity，即可联网生成并追加保留到选题库。';
        statusEl.className = 'mb-4 text-xs font-semibold text-indigo-600 dark:text-indigo-400';
      }
    });

    document.querySelectorAll('.btn-pick-topic').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const title = btn.getAttribute('data-topic-title');
        const id = btn.getAttribute('data-topic-id');
        const promptText = `请使用 steel-blog-workflow 工作流，针对选题【${title}】（目录：${id}）启动 3 路 Swarm 深度调研，抓取高清配图与生成白底信息图，并撰写 1 万字科普长文放入 /studio/ 供我审稿。`;
        try { await navigator.clipboard.writeText(promptText); } catch {}
        const statusEl = document.getElementById('topic-status');
        if (statusEl) {
          statusEl.textContent = `已选定「${title}」并复制 Swarm 指令！直接粘贴发给 Antigravity 即可开始。`;
          statusEl.className = 'mb-4 text-xs font-semibold text-emerald-600 dark:text-emerald-400';
        }
      });
    });

    document.querySelectorAll('.btn-edit-draft').forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-edit-slug');
        if (slug && switcher) {
          switcher.value = slug;
          loadDoc(slug);
          switcher.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // View mode switching
    const paneEdit = document.getElementById('pane-edit')!;
    const panePreview = document.getElementById('pane-preview')!;
    const container = document.getElementById('editor-container')!;
    document.querySelectorAll('.view-mode-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-mode');
        document.querySelectorAll('.view-mode-btn').forEach((b) => {
          b.className = 'view-mode-btn px-2.5 py-1 rounded-md font-medium cursor-pointer text-slate-600 dark:text-slate-300';
        });
        btn.className = 'view-mode-btn px-2.5 py-1 rounded-md font-medium cursor-pointer bg-white dark:bg-slate-800 text-sky-600 dark:text-sky-400 shadow-sm';
        if (mode === 'edit') {
          paneEdit.classList.remove('hidden');
          panePreview.classList.add('hidden');
          container.className = 'grid grid-cols-1 gap-4';
        } else if (mode === 'preview') {
          paneEdit.classList.add('hidden');
          panePreview.classList.remove('hidden');
          container.className = 'grid grid-cols-1 gap-4';
        } else {
          paneEdit.classList.remove('hidden');
          panePreview.classList.remove('hidden');
          container.className = 'grid grid-cols-1 lg:grid-cols-2 gap-4';
        }
      });
    });

    switcher?.addEventListener('change', () => loadDoc(switcher.value));

    ['fm-title', 'fm-date', 'fm-category', 'fm-desc', 'fm-source', 'fm-infographic'].forEach((id) => {
      document.getElementById(id)?.addEventListener('input', updateAll);
      document.getElementById(id)?.addEventListener('change', updateAll);
    });
    editor.addEventListener('input', updateAll);

    document.getElementById('btn-auto-insert')?.addEventListener('click', () => {
      const checked = Array.from(document.querySelectorAll('.cand-check:checked')).map((el) => ({
        src: (el as HTMLInputElement).value,
        cap: el.getAttribute('data-caption') || '',
      }));
      if (checked.length === 0) {
        alert('请先在左侧勾选至少 1 张图片');
        return;
      }
      const lines = editor.value.split('\n');
      let imgIdx = 0;
      const out: string[] = [];
      for (let i = 0; i < lines.length; i++) {
        out.push(lines[i]);
        if (lines[i].startsWith('## ') && imgIdx < checked.length) {
          out.push('');
          out.push(`![${checked[imgIdx].cap}](${checked[imgIdx].src})`);
          imgIdx++;
        }
      }
      while (imgIdx < checked.length) {
        out.push('');
        out.push(`![${checked[imgIdx].cap}](${checked[imgIdx].src})`);
        imgIdx++;
      }
      editor.value = out.join('\n');
      updateAll();
    });

    function buildFullMarkdown() {
      const title = (document.getElementById('fm-title') as HTMLInputElement).value;
      const date = (document.getElementById('fm-date') as HTMLInputElement).value;
      const cat = (document.getElementById('fm-category') as HTMLSelectElement).value;
      const desc = (document.getElementById('fm-desc') as HTMLInputElement).value;
      const src = (document.getElementById('fm-source') as HTMLInputElement).value;
      const info = (document.getElementById('fm-infographic') as HTMLInputElement).value;
      return `---\ntitle: "${title}"\ndate: "${date}"\ncategory: "${cat}"\ndescription: "${desc}"\nsource: "${src}"\ninfographic: "${info}"\n---\n\n${editor.value}\n`;
    }

    document.getElementById('btn-copy-md')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(buildFullMarkdown());
      alert('已复制完整标准格式 Markdown！');
    });

    document.getElementById('btn-download-md')?.addEventListener('click', () => {
      const blob = new Blob([buildFullMarkdown()], { type: 'text/markdown;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'index.md';
      a.click();
    });

    if (docsData.length > 0) {
      loadDoc(docsData[0].slug);
    }
  </script>
</BaseLayout>
