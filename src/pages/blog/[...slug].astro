---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: i < posts.length - 1 ? posts[i + 1] : null,
      nextPost: i > 0 ? posts[i - 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const infographicUrl = post.data.infographic ? `${base}${post.data.infographic}` : '';
---

<BaseLayout title={`${post.data.title} | 钢结构研究院`} description={post.data.description}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <a href={`${base}/blog`} class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400 mb-6 transition-colors">
      ← 返回专栏列表
    </a>

    <header class="mb-7 pb-6 border-b border-slate-200 dark:border-slate-800">
      <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-500 dark:text-slate-400 mb-3">
        <span class="px-2.5 py-0.5 rounded-full bg-sky-50 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300 font-medium">
          {post.data.category}
        </span>
        <time datetime={post.data.date}>{post.data.date}</time>
        {post.data.source && (
          <span>· 参考来源：{post.data.source}</span>
        )}
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-snug">
        {post.data.title}
      </h1>
      {post.data.description && (
        <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed bg-slate-100/70 dark:bg-slate-900/60 p-3.5 rounded-xl border-l-4 border-sky-500">
          {post.data.description}
        </p>
      )}
    </header>

    {infographicUrl && (
      <figure class="article-figure mb-8">
        <img
          src={infographicUrl}
          alt={post.data.title}
        />
        <figcaption class="article-figcaption flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <span class="font-bold text-sky-700 dark:text-sky-400">【项目全景工程信息图】</span>
            <span>{post.data.title}</span>
            {post.data.source && (
              <span class="block text-xs text-slate-400 mt-0.5">资料来源：{post.data.source}</span>
            )}
          </div>
          <a
            href={infographicUrl}
            download={`${post.id}-infographic.jpg`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-700 text-white text-xs font-medium shrink-0 transition-colors"
          >
            下载高清信息图
          </a>
        </figcaption>
      </figure>
    )}

    <div id="article-body" class="prose prose-slate dark:prose-invert prose-editorial prose-headings:font-bold prose-a:text-sky-600 dark:prose-a:text-sky-400 max-w-none">
      <Content />
    </div>

    <!-- Prev / Next Navigation -->
    <nav class="mt-14 pt-6 border-t border-slate-200 dark:border-slate-800 grid sm:grid-cols-2 gap-4">
      {prevPost ? (
        <a
          href={`${base}/blog/${prevPost.id}`}
          class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-sky-400 dark:hover:border-sky-600 transition-colors"
        >
          <div class="text-xs text-slate-400 mb-1">← 上一篇</div>
          <div class="text-sm font-semibold text-slate-800 dark:text-slate-200 line-clamp-1">{prevPost.data.title}</div>
        </a>
      ) : <div />}

      {nextPost ? (
        <a
          href={`${base}/blog/${nextPost.id}`}
          class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-sky-400 dark:hover:border-sky-600 transition-colors text-right"
        >
          <div class="text-xs text-slate-400 mb-1">下一篇 →</div>
          <div class="text-sm font-semibold text-slate-800 dark:text-slate-200 line-clamp-1">{nextPost.data.title}</div>
        </a>
      ) : <div />}
    </nav>
  </article>

  <script is:inline>
    // Enhance all inline article images into centered figures with prominent captions
    const bodyEl = document.getElementById('article-body');
    if (bodyEl) {
      let idx = 1;
      bodyEl.querySelectorAll('p > img').forEach((img) => {
        const p = img.parentElement;
        if (!p || p.childNodes.length > 1) return;
        const fig = document.createElement('figure');
        fig.className = 'article-figure not-prose';
        const clonedImg = img.cloneNode(true);
        fig.appendChild(clonedImg);

        const alt = (img.getAttribute('alt') || '').trim();
        if (alt) {
          const cap = document.createElement('figcaption');
          cap.className = 'article-figcaption';
          cap.innerHTML = `<span class="font-bold text-sky-700 dark:text-sky-400 mr-1.5">配图 ${idx}</span><span>${alt}</span>`;
          fig.appendChild(cap);
        }
        idx++;
        p.replaceWith(fig);
      });
    }
  </script>
</BaseLayout>
