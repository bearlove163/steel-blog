---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: i < posts.length - 1 ? posts[i + 1] : null,
      nextPost: i > 0 ? posts[i - 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={`${post.data.title} | 钢结构研究院`} description={post.data.description}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <a href={`${base}/blog`} class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400 mb-8 transition-colors">
      ← 返回专栏列表
    </a>

    <header class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
      <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 dark:text-slate-400 mb-4">
        <span class="px-2.5 py-1 rounded-full bg-sky-50 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300 font-medium">
          {post.data.category}
        </span>
        <time datetime={post.data.date}>{post.data.date}</time>
        {post.data.source && (
          <span>· 来源：{post.data.source}</span>
        )}
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
        {post.data.title}
      </h1>
    </header>

    <div class="prose prose-slate dark:prose-invert prose-headings:font-bold prose-a:text-sky-600 dark:prose-a:text-sky-400 max-w-none leading-relaxed">
      <Content />
    </div>

    <!-- Prev / Next Navigation -->
    <nav class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800 grid sm:grid-cols-2 gap-4">
      {prevPost ? (
        <a
          href={`${base}/blog/${prevPost.id}`}
          class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-sky-400 dark:hover:border-sky-600 transition-colors"
        >
          <div class="text-xs text-slate-400 mb-1">← 上一篇</div>
          <div class="text-sm font-semibold text-slate-800 dark:text-slate-200 line-clamp-1">{prevPost.data.title}</div>
        </a>
      ) : <div />}

      {nextPost ? (
        <a
          href={`${base}/blog/${nextPost.id}`}
          class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-sky-400 dark:hover:border-sky-600 transition-colors text-right"
        >
          <div class="text-xs text-slate-400 mb-1">下一篇 →</div>
          <div class="text-sm font-semibold text-slate-800 dark:text-slate-200 line-clamp-1">{nextPost.data.title}</div>
        </a>
      ) : <div />}
    </nav>
  </article>
</BaseLayout>
