---
import BaseLayout from '../layouts/BaseLayout.astro';
import terms from '../data/terms.json';
import lessons from '../data/lessons.json';

const categories = ['全部', ...Array.from(new Set(terms.map((t) => t.category)))];
---

<BaseLayout title="工程实验室 | 钢结构研究院" description="钢结构双语术语库、英语闪卡记忆与工程英语语音听力训练。">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="max-w-2xl mb-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">工程实验室</h1>
      <p class="mt-2 text-slate-600 dark:text-slate-400">
        内置 {terms.length} 条钢结构专业中英术语、交互式闪卡记忆（本地保存进度）与 {lessons.length} 节工程英语语音听力训练。
      </p>
    </div>

    <!-- Mode Tabs -->
    <div class="flex flex-wrap gap-2 border-b border-slate-200 dark:border-slate-800 pb-4 mb-8">
      <button type="button" data-tab="glossary" class="lab-tab px-4 py-2 rounded-xl text-sm font-semibold bg-sky-600 text-white cursor-pointer">
        📖 双语术语库 ({terms.length})
      </button>
      <button type="button" data-tab="flashcard" class="lab-tab px-4 py-2 rounded-xl text-sm font-semibold bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-800 cursor-pointer">
        🃏 英语闪卡记忆
      </button>
      <button type="button" data-tab="listening" class="lab-tab px-4 py-2 rounded-xl text-sm font-semibold bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-800 cursor-pointer">
        🎧 语音听力训练 ({lessons.length})
      </button>
    </div>

    <!-- Panel 1: Glossary -->
    <section id="panel-glossary" class="lab-panel space-y-6">
      <div class="flex flex-col sm:flex-row gap-4 justify-between items-start sm:items-center">
        <div class="flex flex-wrap gap-2">
          {categories.slice(0, 10).map((cat, idx) => (
            <button
              type="button"
              data-term-cat={cat}
              class={`term-cat-btn px-3 py-1.5 rounded-lg text-xs font-medium cursor-pointer transition-colors ${
                idx === 0
                  ? 'bg-sky-600 text-white'
                  : 'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-800'
              }`}
            >
              {cat}
            </button>
          ))}
        </div>
        <input
          id="term-search"
          type="search"
          placeholder="搜索英文、中文或例句..."
          class="w-full sm:w-72 px-4 py-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500"
        />
      </div>

      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 shadow-sm">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-slate-500 dark:text-slate-400 text-xs uppercase">
              <th class="py-3.5 px-4">英文术语</th>
              <th class="py-3.5 px-4">中文释义</th>
              <th class="py-3.5 px-4 hidden sm:table-cell">分类</th>
              <th class="py-3.5 px-4 hidden md:table-cell">工程例句</th>
              <th class="py-3.5 px-4 text-right">发音</th>
            </tr>
          </thead>
          <tbody id="glossary-tbody" class="divide-y divide-slate-100 dark:divide-slate-800/80">
            {terms.map((t) => (
              <tr
                class="term-row hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors"
                data-cat={t.category}
                data-search={`${t.en} ${t.zh} ${t.category} ${t.example}`.toLowerCase()}
              >
                <td class="py-3.5 px-4 font-semibold text-sky-700 dark:text-sky-400">{t.en}</td>
                <td class="py-3.5 px-4 text-slate-800 dark:text-slate-200">{t.zh}</td>
                <td class="py-3.5 px-4 hidden sm:table-cell">
                  <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-xs text-slate-600 dark:text-slate-300">
                    {t.category}
                  </span>
                </td>
                <td class="py-3.5 px-4 text-slate-500 dark:text-slate-400 hidden md:table-cell max-w-md">{t.example}</td>
                <td class="py-3.5 px-4 text-right">
                  <button
                    type="button"
                    data-speak={t.en}
                    class="speak-btn px-2.5 py-1 rounded-lg text-xs bg-sky-50 hover:bg-sky-100 dark:bg-sky-950/60 dark:hover:bg-sky-900 text-sky-700 dark:text-sky-300 cursor-pointer"
                  >
                    🔊 朗读
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Panel 2: Flashcards -->
    <section id="panel-flashcard" class="lab-panel hidden">
      <div class="max-w-xl mx-auto">
        <div class="flex items-center justify-between text-sm text-slate-500 dark:text-slate-400 mb-4">
          <span id="fc-progress">进度：1 / {terms.length}</span>
          <span id="fc-mastered-count">已掌握：0</span>
        </div>

        <div
          id="fc-card"
          class="min-h-[280px] p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-md flex flex-col items-center justify-center text-center cursor-pointer select-none transition-all hover:border-sky-400"
        >
          <span id="fc-cat" class="px-2.5 py-0.5 rounded-full text-xs bg-sky-50 dark:bg-sky-950 text-sky-700 dark:text-sky-300 mb-4"></span>
          <h2 id="fc-en" class="text-3xl font-extrabold text-slate-900 dark:text-white"></h2>
          <p id="fc-zh" class="hidden mt-4 text-xl font-bold text-sky-600 dark:text-sky-400"></p>
          <p id="fc-ex" class="hidden mt-3 text-sm text-slate-500 dark:text-slate-400 max-w-md"></p>
          <p id="fc-hint" class="mt-6 text-xs text-slate-400">点击卡片翻转查看中文释义与例句</p>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
          <button id="fc-prev" type="button" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-sm font-medium cursor-pointer">
            ← 上一个
          </button>
          <div class="flex gap-2">
            <button id="fc-speak" type="button" class="px-4 py-2 rounded-xl bg-sky-50 dark:bg-sky-950 text-sky-700 dark:text-sky-300 text-sm font-medium cursor-pointer">
              🔊 朗读
            </button>
            <button id="fc-master" type="button" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium cursor-pointer">
              ✓ 标记已掌握
            </button>
          </div>
          <button id="fc-next" type="button" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-sm font-medium cursor-pointer">
            下一个 →
          </button>
        </div>
      </div>
    </section>

    <!-- Panel 3: Listening -->
    <section id="panel-listening" class="lab-panel hidden">
      <div class="grid lg:grid-cols-3 gap-6">
        <div class="lg:col-span-1 space-y-2 max-h-[600px] overflow-y-auto pr-1">
          {lessons.map((l, idx) => (
            <button
              type="button"
              data-lesson-idx={idx}
              class={`lesson-item w-full text-left p-4 rounded-xl border transition-colors cursor-pointer ${
                idx === 0
                  ? 'border-sky-500 bg-sky-50/70 dark:bg-sky-950/40'
                  : 'border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 hover:border-sky-300'
              }`}
            >
              <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
                <span>Lesson {l.id}</span>
                <span>{l.duration} · {l.level}</span>
              </div>
              <div class="font-semibold text-sm text-slate-900 dark:text-white">{l.title}</div>
              <div class="text-xs text-slate-500 dark:text-slate-400 truncate mt-0.5">{l.title_en}</div>
            </button>
          ))}
        </div>

        <div class="lg:col-span-2 p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-slate-200 dark:border-slate-800">
            <div>
              <h2 id="ls-title" class="text-xl font-bold text-slate-900 dark:text-white"></h2>
              <p id="ls-title-en" class="text-sm text-slate-500 dark:text-slate-400 mt-0.5"></p>
            </div>
            <div class="flex items-center gap-2">
              <select id="ls-rate" class="px-2.5 py-1.5 rounded-lg text-xs border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800">
                <option value="0.75">0.75x 慢速</option>
                <option value="1" selected>1.0x 正常</option>
                <option value="1.25">1.25x 较快</option>
              </select>
              <button id="ls-play" type="button" class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-sm font-medium cursor-pointer">
                ▶ 语音朗读
              </button>
              <button id="ls-stop" type="button" class="px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 text-sm cursor-pointer">
                停止
              </button>
            </div>
          </div>

          <div class="mt-6 space-y-6">
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">English Transcript</h3>
              <p id="ls-en" class="text-base text-slate-800 dark:text-slate-200 leading-relaxed"></p>
            </div>
            <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">中文翻译</h3>
              <p id="ls-zh" class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed"></p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script define:vars={{ terms, lessons }}>
    // Speech helper
    function speakText(text, rate = 1) {
      if (!('speechSynthesis' in window)) {
        alert('当前浏览器不支持语音合成功能');
        return;
      }
      window.speechSynthesis.cancel();
      const utter = new SpeechSynthesisUtterance(text);
      utter.lang = 'en-US';
      utter.rate = Number(rate) || 1;
      window.speechSynthesis.speak(utter);
    }

    // Tabs
    const tabs = document.querySelectorAll('.lab-tab');
    const panels = document.querySelectorAll('.lab-panel');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');
        tabs.forEach((t) => {
          t.className = 'lab-tab px-4 py-2 rounded-xl text-sm font-semibold bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-800 cursor-pointer';
        });
        tab.className = 'lab-tab px-4 py-2 rounded-xl text-sm font-semibold bg-sky-600 text-white cursor-pointer';
        panels.forEach((p) => p.classList.add('hidden'));
        document.getElementById(`panel-${target}`)?.classList.remove('hidden');
      });
    });

    // Glossary filter + speak
    let activeTermCat = '全部';
    const termBtns = document.querySelectorAll('.term-cat-btn');
    const termRows = document.querySelectorAll('.term-row');
    const termSearch = document.getElementById('term-search');

    function filterTerms() {
      const q = (termSearch?.value || '').trim().toLowerCase();
      termRows.forEach((row) => {
        const cat = row.getAttribute('data-cat');
        const txt = row.getAttribute('data-search') || '';
        const ok = (activeTermCat === '全部' || cat === activeTermCat) && (!q || txt.includes(q));
        row.classList.toggle('hidden', !ok);
      });
    }

    termBtns.forEach((b) => {
      b.addEventListener('click', () => {
        activeTermCat = b.getAttribute('data-term-cat') || '全部';
        termBtns.forEach((btn) => {
          btn.className = 'term-cat-btn px-3 py-1.5 rounded-lg text-xs font-medium cursor-pointer transition-colors bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-800';
        });
        b.className = 'term-cat-btn px-3 py-1.5 rounded-lg text-xs font-medium cursor-pointer transition-colors bg-sky-600 text-white';
        filterTerms();
      });
    });
    termSearch?.addEventListener('input', filterTerms);
    document.querySelectorAll('.speak-btn').forEach((btn) => {
      btn.addEventListener('click', () => speakText(btn.getAttribute('data-speak') || ''));
    });

    // Flashcards
    let fcIndex = 0;
    let fcFlipped = false;
    const masteredSet = new Set(JSON.parse(localStorage.getItem('steel_mastered_terms') || '[]'));

    function renderFlashcard() {
      const item = terms[fcIndex];
      if (!item) return;
      document.getElementById('fc-cat').textContent = item.category;
      document.getElementById('fc-en').textContent = item.en;
      document.getElementById('fc-zh').textContent = item.zh;
      document.getElementById('fc-ex').textContent = item.example || '';
      document.getElementById('fc-progress').textContent = `进度：${fcIndex + 1} / ${terms.length}`;
      document.getElementById('fc-mastered-count').textContent = `已掌握：${masteredSet.size}`;
      document.getElementById('fc-zh').classList.toggle('hidden', !fcFlipped);
      document.getElementById('fc-ex').classList.toggle('hidden', !fcFlipped);
      document.getElementById('fc-hint').classList.toggle('hidden', fcFlipped);
    }

    document.getElementById('fc-card')?.addEventListener('click', () => {
      fcFlipped = !fcFlipped;
      renderFlashcard();
    });
    document.getElementById('fc-prev')?.addEventListener('click', () => {
      fcIndex = (fcIndex - 1 + terms.length) % terms.length;
      fcFlipped = false;
      renderFlashcard();
    });
    document.getElementById('fc-next')?.addEventListener('click', () => {
      fcIndex = (fcIndex + 1) % terms.length;
      fcFlipped = false;
      renderFlashcard();
    });
    document.getElementById('fc-speak')?.addEventListener('click', () => {
      speakText(terms[fcIndex]?.en || '');
    });
    document.getElementById('fc-master')?.addEventListener('click', () => {
      const id = terms[fcIndex]?.id;
      if (id != null) {
        masteredSet.add(id);
        localStorage.setItem('steel_mastered_terms', JSON.stringify([...masteredSet]));
        fcIndex = (fcIndex + 1) % terms.length;
        fcFlipped = false;
        renderFlashcard();
      }
    });
    renderFlashcard();

    // Listening
    let activeLessonIdx = 0;
    function renderLesson(idx) {
      activeLessonIdx = idx;
      const l = lessons[idx];
      if (!l) return;
      document.getElementById('ls-title').textContent = l.title;
      document.getElementById('ls-title-en').textContent = l.title_en || '';
      document.getElementById('ls-en').textContent = l.content_en || '';
      document.getElementById('ls-zh').textContent = l.content_zh || '';
    }
    document.querySelectorAll('.lesson-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-lesson-idx'));
        document.querySelectorAll('.lesson-item').forEach((b) => {
          b.className = 'lesson-item w-full text-left p-4 rounded-xl border transition-colors cursor-pointer border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 hover:border-sky-300';
        });
        btn.className = 'lesson-item w-full text-left p-4 rounded-xl border transition-colors cursor-pointer border-sky-500 bg-sky-50/70 dark:bg-sky-950/40';
        window.speechSynthesis?.cancel();
        renderLesson(idx);
      });
    });
    document.getElementById('ls-play')?.addEventListener('click', () => {
      const rate = document.getElementById('ls-rate')?.value || '1';
      speakText(lessons[activeLessonIdx]?.content_en || '', rate);
    });
    document.getElementById('ls-stop')?.addEventListener('click', () => {
      window.speechSynthesis?.cancel();
    });
    renderLesson(0);
  </script>
</BaseLayout>
